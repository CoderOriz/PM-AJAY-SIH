# PM-AJAY demo environment — copy to .env (gitignored) and adjust if needed.
# Read by backend/main.py and backend/seed.py. No dotenv dependency: export these
# vars yourself or load the file with your own tooling.

# SQLite database file name/path. Relative paths resolve against backend/.
# backend/seed.py RECREATES this file — running it wipes all session data.
PM_AJAY_DB=pmajay.db

# Phone-hash salt. Changing it invalidates every stored session's phone_hash
# (existing sessions stop resuming). Use a real secret before real beneficiary data.
PM_AJAY_SALT=pmajay-demo-salt

# Admin JWT signing secret (Q3/RBAC — docs/DECISIONS.md D6). Use a real secret
# before any deployment.
PM_AJAY_JWT_SECRET=pmajay-demo-jwt-secret
